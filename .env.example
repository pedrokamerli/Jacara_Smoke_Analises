# Defina localmente uma chave aleatória longa antes de calcular chaves pseudonimizadas.
# Não coloque a chave real neste arquivo nem em código, planilhas, logs ou commits.
JACARE_ANALYTICS_HMAC_KEY=

# O padrão é público e somente leitura. Para trabalhar LOCALMENTE com importação:
# PowerShell: $env:JACARE_PUBLIC_MODE = 'false'
# O arquivo .env não é carregado automaticamente pelo aplicativo.
JACARE_PUBLIC_MODE=true
JACARE_AUTH_MODE=oidc

# A imagem pública contém apenas demo/public; não montar dados reais nela.
JACARE_PUBLIC_DATA_DIR=demo/public
